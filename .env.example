# Execution device: auto, NPU, GPU, or CPU
OPENVINO_DEVICE=auto

# FFmpeg command or absolute Windows path
FFMPEG_PATH=ffmpeg

# Local-only directories. Do not point these to a synced repository folder.
LOCALSUB_OUTPUT_DIR=./data/output
LOCALSUB_MODEL_DIR=./data/models

# DEBUG, INFO, WARNING, ERROR
LOCALSUB_LOG_LEVEL=INFO
